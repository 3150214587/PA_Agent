        def slow_stage2_chat(messages, **kwargs):
            ct: CancelToken = kwargs.get("cancel_token")
            if ct is not None:
                cancel_token_holder.append(ct)
            stage2_started_event.set()
            # Block until cancelled (simulates a long-running API call)
